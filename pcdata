	local GPUVENDOR=$(lspci | grep -iE 'vga|3d|display' | head -n1 | grep -oiE 'nvidia|amd|intel' | tr '[:lower:]' '[:upper:]')
	local VRAMTOTAL VRAMUSED GPUUSAGE GPUTEMP GPUCLOCK DRIVERVERSION GPUPOWER GPUDATA CARDPATH HWMON

# Select the correct function according to the CPU vendor detection

	case "$GPUVENDOR" in
    		NVIDIA) detect_nvidia ;;
    		AMD)    detect_amd    ;;
    		INTEL)  detect_intel  ;;
    		*)
    			VRAMTOTAL="Not Available" VRAMUSED="Not Available" GPUUSAGE="Not Available" GPUTEMP="Not Available"
    			GPUCLOCK="Not Available" DRIVERVERSION="Not Available" GPUPOWER="Not Available"
        ;;
	esac

# Formatting output and loop for the realtime information.

	tput cup 0 0
	
	echo -e "${blue}------------------ REALTIME INFORMATION ------------------${nocolor}\n"

    echo -e "${blue}Realtime RAM/CPU information:${nocolor}"
    
    echo -en "Used/Total RAM:				$MEMNOW"
    tput el
    echo
    echo -en "Used/Total Swap:			$SWAPNOW"
    tput el
    echo
    
    echo -en "Current CPU Usage:			$CPUUSAGE"
	tput el
	echo
	echo -en "Current CPU Temperature:		$CPUTEMP"
	tput el
	echo
	echo -en "Current CPU Clock Speed:		$CLOCK"
	tput el
	echo
	echo -en "Current CPU Multiplier:			$MULTIPLIER"
	tput el
	echo
    
    echo -e "\n${blue}Realtime GPU information:${nocolor}"
    
    echo -en "VRAM Used:				$VRAMUSED"
    tput el
    echo
    echo -en "GPU Usage:				$GPUUSAGE"
    tput el
    echo
    echo -en "Current GPU Temperature:		$GPUTEMP"
    tput el
    echo
    echo -en "Current GPU Clock Speed:		$GPUCLOCK"
    tput el
    echo
    echo -en "GPU Power Draw:				$GPUPOWER"
    tput el
    echo

    echo -e "\n${yellow}Press ENTER to go back to the MENU or CTRL+C to exit.${nocolor}" 
    read -r answer4

    if [[ -z "$answer4" ]]; then
        break
    fi

