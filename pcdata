# RAM, CPU, GPU

realtime_section () {

echo -e "${yellow}This script requires administrator privileges to read hardware data.${nocolor}"

sudo -v || { echo -e "${red}Authentication failed!${nocolor}"; exit 1; }

clear

while true; do

# CPU / RAM / SWAP
	local CPUTEMP=$(sensors | grep -E "Tctl:|Package id 0:" | awk '{print $4 ? $4 : $2}' \
| tr -d '+') && CPUTEMP=${CPUTEMP:-"N/A (Install 'lm_sensors' and run the 'sensors-detect' command.)"}
	local CLOCK=$(grep "cpu MHz" /proc/cpuinfo | head -n1 | cut -d: -f2 | sed -e 's/^[ \t]*//')
	local MULTIPLIER=$(grep "cpu MHz" /proc/cpuinfo | head -n1 | cut -d: -f2 | awk '{printf "x%.1f\n", $1/100}')
	local CPUUSAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print 100 - $8"%"}')
	local MEMNOW=$(free -h | grep Mem: | awk '{print $3"/"$2}')
	local SWAPNOW=$(free -h | grep Swap: | awk '{print $3"/"$2}')

# GPU
	local GPUNAME=$(lspci | grep -iE 'vga|3d|display' | head -n1 | sed -E 's/.*\[(.*)\].*/\1/')
