# Function 04 --------------------------------------------------------------------#

main_section () {

# Defining variables:
local OSNAME=$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d= -f2 | tr -d '"')
local DENAME=$(echo $XDG_CURRENT_DESKTOP)
local KERNELNAME=$(uname -r)
local UPTIME=$(uptime -p | sed 's/up //')
local SHELLNAME=$(echo "${SHELL##*/} $( $SHELL --version | grep -oE '[0-9]+\.[0-9.]+' | head -n1 )")
local CPUNAME=$(grep -m1 "model name" /proc/cpuinfo | cut -d: -f2 | sed -e 's/^[ \t]*//')
local GPUNAME=$(lspci | grep -iE 'vga|3d|display' | sed -E 's/.*\[(.*)\].*/\1/' | xargs | sed 's/ /, /g')
local TOTALRAM=$(free -k | grep "Mem:" | awk '{printf "%.1f GiB\n", $2/1024/1024}')
local TOTALSWAP=$(free -h | awk '/^Swap:/ {print $2}')
local MYDISKS=$(df -h --output=source,used,size,pcent,target,fstype | grep "^/dev/" \
| sed 's/  */,/g; s/,fuseblk/,ntfs/g; s/,ntfs3/,ntfs/g' \
| awk -v color="$blue" -v nc="$nocolor" -F, \
'{printf "%sDisk (%s):%s %s / %s (%s) at %s [%s]\n", color, $1, nc, $2, $3, $4, $5, $6}')
local MYMONITORS=$(xrandr --query 2>/dev/null | awk -v color="$blue" -v \
nc="$nocolor" '/ connected/ {p=$1} /\*/ {res=$1; freq=$2; gsub(/[*+]/, "", \
freq); printf "%s%s:%s %s @ %sHz\n", color, p, nc, res, freq}')
local VIDEODRIVER=$(lspci -k | grep -EiA 3 "vga|video|3d" | grep "in use" | sed 's/.*: //')
local IFBAT=$(upower -i $(upower -e 2>/dev/null | grep 'BAT') 2>/dev/null | grep 'percentage' | awk '{print $2}')
local USBDEV=$(lsusb)
local MAINLOCALIP=$(ip route get 1 | awk '{print $7; exit}')
local TAILSCALEIP=$(tailscale ip 2> /dev/null | head -n1)

# Formatting output
clear

echo -e "${blue}------------------ GENERAL SYSTEM INFORMATION ------------------${nocolor}\n"

echo -e "${blue}OS:${nocolor} $OSNAME"
echo -e "${blue}DE:${nocolor} $DENAME"
echo -e "${blue}Kernel:${nocolor} $KERNELNAME"
echo -e "${blue}Uptime:${nocolor} $UPTIME"
echo -e "${blue}Shell:${nocolor} $SHELLNAME"
echo -e "${blue}CPU:${nocolor} $CPUNAME"
