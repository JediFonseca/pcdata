# Function 05 --------------------------------------------------------------------#

detect_nvidia () {

if command -v nvidia-smi >/dev/null; then
    GPUDATA=$(nvidia-smi --query-gpu=driver_version,memory.total,memory.used,utilization.gpu,temperature.\
gpu,clocks.sm,power.draw --format=csv,noheader,nounits)
    DRIVERVERSION=$(echo "$GPUDATA" | awk -F', ' '{print $1}')
    VRAMTOTAL=$(echo "$GPUDATA" | awk -F', ' '{printf "%.0f MiB\n", $2}')
    VRAMUSED=$(echo "$GPUDATA" | awk -F', ' '{printf "%.0f MiB\n", $3}')
    GPUUSAGE=$(echo "$GPUDATA" | awk -F', ' '{printf "%s%%\n", $4}')
    GPUTEMP=$(echo "$GPUDATA" | awk -F', ' '{printf "%s°C\n", $5}')
    GPUCLOCK=$(echo "$GPUDATA" | awk -F', ' '{printf "%s MHz\n", $6}')
    GPUPOWER=$(echo "$GPUDATA" | awk -F', ' '{printf "%s W\n", $7}')
else
    DRIVERVERSION="Not Available (Install the proprietary NVIDIA driver for full data.)"
    VRAMTOTAL="Not Available" VRAMUSED="Not Available" GPUUSAGE="Not Available" GPUTEMP="Not Available"
    GPUCLOCK="Not Available" GPUPOWER="Not Available"
fi

}

# Function 06 --------------------------------------------------------------------#

detect_amd () {

CARDPATH=$(for c in /sys/class/drm/card[0-9]/device; do
[[ "$(cat "$c/vendor" 2>/dev/null)" == "0x1002" ]] && echo "$c" && break
done)

if [[ -n "$CARDPATH" ]]; then
    VRAMTOTAL=$(awk '{printf "%.0f MiB\n", $1/1024/1024}' "$CARDPATH/mem_info_vram_total" 2>/dev/null)
    VRAMUSED=$(awk '{printf "%.0f MiB\n", $1/1024/1024}' "$CARDPATH/mem_info_vram_used" 2>/dev/null)
    GPUUSAGE=$(cat "$CARDPATH/gpu_busy_percent" 2>/dev/null | awk '{print $1"%"}')
    HWMON=$(ls -d "$CARDPATH"/hwmon/hwmon* 2>/dev/null | head -n1)
    GPUTEMP=$([[ -n "$HWMON" ]] && awk '{printf "%.1f°C\n", $1/1000}' "$HWMON/temp1_input" 2>/dev/null)
    GPUCLOCK=$(cat "$CARDPATH/pp_dpm_sclk" 2>/dev/null | grep '\*' | awk '{print $2}')
    GPUPOWER=$([[ -n "$HWMON" ]] && awk '{printf "%.1f W\n", $1/1000000}' "$HWMON/power1_input" 2>/dev/null)
    DRIVERVERSION="Not Available"
else
    VRAMTOTAL="Not Available" VRAMUSED="Not Available" GPUUSAGE="Not Available" GPUTEMP="Not Available"
    GPUCLOCK="Not Available" DRIVERVERSION="Not Available" GPUPOWER="Not Available"
fi

}

# Function 07 --------------------------------------------------------------------#

detect_intel () {

CARDPATH=$(ls -d /sys/class/drm/card[0-9] 2>/dev/null | head -n1)
GPUCLOCK=$([[ -n "$CARDPATH" ]] && cat "$CARDPATH/gt_cur_freq_mhz" 2>/dev/null | awk '{print $1" MHz"}')
GPUCLOCK=${GPUCLOCK:-"Not Available"}
VRAMTOTAL="Not Available (shares system RAM)" VRAMUSED="Not Available"
GPUTEMP="Not Available" DRIVERVERSION="Not Available" GPUPOWER="Not Available"

if command -v intel_gpu_top >/dev/null; then
    GPUDATA=$(sudo timeout 2 intel_gpu_top -J -s 1000 -o - 2>/dev/null)
    GPUUSAGE=$(echo "$GPUDATA" | grep -A1 '"Render/3D"' | grep '"busy"' | tail -n1 \
| grep -oE '[0-9]+\.[0-9]+' | awk '{printf "%.1f%%\n", $1}')
    GPUUSAGE=${GPUUSAGE:-"Not Available"}
else
    GPUUSAGE="Not Available (install 'igt-gpu-tools' for this data)"
fi

}

# Function 08 --------------------------------------------------------------------#

gpu_section () {

echo -e "${yellow}This script requires administrator privileges to read hardware data.${nocolor}"

sudo -v || { echo -e "${red}Authentication failed!${nocolor}"; exit 1; }

# Setting variables.

local GPUNAME=$(lspci | grep -iE 'vga|3d|display' | head -n1 | sed -E 's/.*\[(.*)\].*/\1/')
local DRIVERINUSE=$(lspci -k | grep -EiA3 "vga|3d|display" | grep "in use" | head -n1 | sed 's/.*: //')
local GPUVENDOR=$(lspci | grep -iE 'vga|3d|display' | head -n1 | grep -oiE 'nvidia|amd|intel' | tr '[:lower:]' '[:upper:]')
local VRAMTOTAL VRAMUSED GPUUSAGE GPUTEMP GPUCLOCK DRIVERVERSION GPUPOWER GPUDATA CARDPATH HWMON

clear

# Select the correct function according to the CPU vendor detection

while true; do

    case "$GPUVENDOR" in
        NVIDIA) detect_nvidia ;;
        AMD)    detect_amd    ;;
        INTEL)  detect_intel  ;;
        *)
            VRAMTOTAL="Not Available" VRAMUSED="Not Available" GPUUSAGE="Not Available" GPUTEMP="Not Available"
            GPUCLOCK="Not Available" DRIVERVERSION="Not Available" GPUPOWER="Not Available"
        ;;
	esac

# Formatting output and loop for the realtime information.

	tput cup 0 0

    echo -e "${blue}--------------------------- GPU INFORMATION ---------------------------${nocolor}"

    echo -e "\n${blue}Static Information:${nocolor}"
    echo -e "Model Name:                   $GPUNAME"
    echo -e "Vendor:                       $GPUVENDOR"
    echo -e "VRAM Total:                   $VRAMTOTAL"
    echo -e "Driver in use (kernel):       $DRIVERINUSE"
    echo -e "Driver version:               $DRIVERVERSION"

    echo -e "\n${blue}Realtime information:${nocolor}"
    echo -en "VRAM Used:                    $VRAMUSED"
    tput el
    echo
    echo -en "GPU Usage:                    $GPUUSAGE"
    tput el
    echo
    echo -en "Current Temperature:          $GPUTEMP"
    tput el
    echo
    echo -en "Current Clock Speed:          $GPUCLOCK"
    tput el
    echo
    echo -en "Power Draw:                   $GPUPOWER"
    tput el
    echo

    echo -e "\n${yellow}Press ENTER to go back to the MENU or CTRL+C to exit.${nocolor}" 
    read -r answer3

    if [[ -z "$answer3" ]]; then
        break
    fi

    [[ "$GPUVENDOR" != "INTEL" ]] && sleep 1
done

}

