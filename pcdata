export LC_ALL=C

if [[ ":$PATH:" != *":/usr/sbin:"* ]]; then
    PATH="/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
fi

# Variables ----------------------------------------------------------------------#

green='\033[0;32m'
blue='\033[0;36m'
yellow='\033[1;33m'
red='\033[0;31m'
nocolor='\033[0m'

version="1.1"
pcdata_url="https://raw.githubusercontent.com/JediFonseca/pcdata/refs/heads/main/pcdata"

local_version=$(grep "^version=" "$0")
remote_version=$(curl -s --max-time 2 "$pcdata_url" 2>/dev/null | grep "^version=")

# Function 01 --------------------------------------------------------------------#

help_section () {

clear

echo -e "${blue}How to use this script:${nocolor}\n"

echo -e "Run \"pcdata\" for basic system and hardware information.\n"

echo -e "${blue}For more details, use the following flags:${nocolor}"
echo -e "--cpu: for advanced CPU information."
echo -e "--ram: for advanced RAM information."
echo -e "--gpu: for advanced GPU information."
echo -e "--now: for all realtime information."
echo -e "--update: for updating PCData to the latest version."
echo -e "--uninstall: for uninstalling PCData completely."
[[ -n "$remote_version" ]] && [[ "$local_version" != "$remote_version" ]] && echo -e "\n${yellow}\
An update is available! Run 'pcdata --update' to install it.${nocolor}"
echo
echo -e "${blue}DEPENDENCIES:${nocolor}"
echo -e "${blue}For this script to work properly, you'll need the following packages:${nocolor}"
echo -e "dmidecode, lm_sensors, util-linux, xrandr, curl, upower and pciutils. (Package names based on Fedora 44.)"
echo
echo "Version: $version"
echo
echo -e "${yellow}Press ENTER to go back to the MENU or CTRL+C to exit.${nocolor}" 
read -r

}

# Function 02 --------------------------------------------------------------------#

cpu_section () {

echo -e "${yellow}This script requires administrator privileges to read hardware data.${nocolor}"

sudo -v || { echo -e "${red}Authentication failed!${nocolor}"; exit 1; }

        # Setting global variables.

local MANUFACTURER=$(sudo dmidecode -t processor | grep "Manufacturer" | sed 's/.*: *//')
local MODELNAME=$(grep -m1 "model name" /proc/cpuinfo | cut -d: -f2 | sed -e 's/^[ \t]*//')
local CORES=$(lscpu | grep "Core(s) per socket:" | awk '{print $4}')
local THREADS=$(lscpu | grep "^CPU(s):" | head -n1 | awk '{print $2}')
local GOVERNOR=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
local SOCKET=$(sudo dmidecode -t processor | grep "Upgrade:" | cut -d: -f2 | sed -e 's/^[ \t]*//')
local VOLTAGE=$(sudo dmidecode -t processor | grep "Voltage" | sed 's/.*: *//')
local FAMILYNUMBER=$(grep -m1 "cpu family" /proc/cpuinfo | cut -d: -f2 | sed -e 's/^[ \t]*//')
local MODELNUMBER=$(grep "^model" /proc/cpuinfo | grep -v "model name" | head -n1 | cut -d: -f2 | sed 's/^[ \t]*//')
local STEPPING=$(grep -m1 "stepping" /proc/cpuinfo | cut -d: -f2 | sed -e 's/^[ \t]*//')
local INSTRUCTIONS=$(lscpu | grep -E "Flags|Options" \
| grep -iowE "mmx|sse|sse2|sse3|ssse3|sse4_1|sse4_2|avx|avx2|avx512|fma|aes|sha|vmx|svm|lm" \
| tr '[:lower:]' '[:upper:]' | tr '_' '.' | sort -u | xargs | sed 's/ /, /g')
local MAXCLOCK=$(sudo dmidecode -t processor | grep "Max Speed" | sed 's/.*: *//')
local CACHEL1D=$(lscpu | grep -E "L1d" | sed 's/.*: *//')
local CACHEL1I=$(lscpu | grep -E "L1i" | sed 's/.*: *//')
local CACHEL2=$(lscpu | grep -E "L2" | sed 's/.*: *//')
local CACHEL3=$(lscpu | grep -E "L3" | sed 's/.*: *//')
        
clear

# Formatting output and loop for the realtime information.

while true; do

	# Variables for the realtime information.
	local CPUTEMP=$(sensors | grep -E "Tctl:|Package id 0:" | awk '{print $4 ? $4 : $2}' \
| tr -d '+') && CPUTEMP=${CPUTEMP:-"N/A (Install 'lm_sensors' and run the 'sensors-detect' command.)"}
	local CLOCK=$(grep "cpu MHz" /proc/cpuinfo | head -n1 | cut -d: -f2 | sed -e 's/^[ \t]*//')
	local MULTIPLIER=$(grep "cpu MHz" /proc/cpuinfo | head -n1 | cut -d: -f2 | awk '{printf "x%.1f\n", $1/100}')
	local CPUUSAGE=$(top -bn1 | grep "Cpu(s)" | awk '{print 100 - $8"%"}')

	tput cup 0 0

	echo -e "${blue}------------------------ CPU INFORMATION ------------------------${nocolor}"

	echo -e "\n${blue}Static Information:${nocolor}"
	echo -e "Manufacturer:                 $MANUFACTURER"
	echo -e "Model Name:                   $MODELNAME"
	echo -e "Number of Cores:              $CORES"
	echo -e "Number of Threads:            $THREADS"
	echo -e "Governor (Power mode):        $GOVERNOR"
	echo -e "Socket:                       $SOCKET"
	echo -e "Default Voltage:              $VOLTAGE"
	echo -e "Family Number:                $FAMILYNUMBER"
	echo -e "Model Number:                 $MODELNUMBER"
	echo -e "Stepping:                     $STEPPING"
	echo -e "Maximum Clock Speed:          $MAXCLOCK"
	echo -e "Cache L1d:                    $CACHEL1D"
	echo -e "Cache L1i:                    $CACHEL1I"
	echo -e "Cache L2:                     $CACHEL2"
	echo -e "Cache L3:                     $CACHEL3"
	echo -e "Instructions:"
	echo -e "$INSTRUCTIONS" | fmt -w 75

	echo -e "\n${blue}Realtime information:${nocolor}"
	echo -en "Current Usage:               $CPUUSAGE"
	tput el
	echo
	echo -en "Current Temperature:         $CPUTEMP"
	tput el
	echo
	echo -en "Current Clock Speed:         $CLOCK"
	tput el
	echo
	echo -en "Current Multiplier:          $MULTIPLIER"
	tput el
	echo

	echo -e "\n${yellow}Press ENTER to go back to the MENU or CTRL+C to exit.${nocolor}" 
    read -r answer1

    if [[ -z "$answer1" ]]; then
        break
    fi

	sleep 1
done

}

